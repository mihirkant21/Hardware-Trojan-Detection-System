# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Environment & secrets
*.env
.env.*
.venv/
env/
venv/

# ─── Node / Frontend ──────────────────────────────────────────────────────────
node_modules/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vite build output (dashboard/dist is regenerated by `pnpm run build`)
dashboard/dist/
dashboard/dist-ssr/
*.local

# ─── Simulation Artefacts ─────────────────────────────────────────────────────
# Waveform & compiled simulation files (regenerated by iverilog/simulate.bat)
*.vcd
*.vvp
*.sim_output.csv

# Raw simulation CSV dumps (processed into alu_trojan_dataset.csv)
alu_16bit/raw_sim_output.csv
alu_16bit/stim_*.hex

# ─── Editor / IDE ─────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── OS specific ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
scratch/
